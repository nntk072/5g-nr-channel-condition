{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/docs/research/schema/requirement-ledger.v1.schema.json",
  "title": "LOS Lab requirement ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status_note", "source_checkpoint", "requirements"],
  "properties": {
    "schema": {"const": "loslab.requirement-ledger.v1"},
    "status_note": {"type": "string", "minLength": 1},
    "source_checkpoint": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "authority", "backlog_aliases", "requirement", "scope", "implementation", "verification", "qualification", "dependencies", "external_blockers", "closure"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "authority": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "backlog_aliases": {"type": "array", "items": {"type": "string"}},
          "requirement": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": {"type": "string"}}]},
          "scope": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "support_envelope"],
            "properties": {
              "status": {"enum": ["unreviewed", "mandatory", "conditional", "later", "out_of_scope_with_authority"]},
              "support_envelope": {"oneOf": [{"type": "string"}, {"type": "object"}, {"type": "null"}]}
            }
          },
          "implementation": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "evidence", "basis"],
            "properties": {
              "status": {"enum": ["unknown", "absent", "partial", "complete"]},
              "evidence": {"type": "array", "items": {"type": "string"}},
              "basis": {"type": "string", "minLength": 1}
            }
          },
          "verification": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "command", "commit"],
            "properties": {
              "status": {"enum": ["not_run", "pass", "fail", "incomplete"]},
              "command": {"type": ["string", "null"]},
              "commit": {"type": ["string", "null"]}
            }
          },
          "qualification": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "evidence"],
            "properties": {
              "status": {"enum": ["not_applicable", "not_qualified", "failed", "unresolved", "qualified_within_scope"]},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }
          },
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "external_blockers": {"type": "array", "items": {"type": "string"}},
          "closure": {
            "type": "object", "additionalProperties": false,
            "required": ["deliverable", "pass_rule", "next_task"],
            "properties": {
              "deliverable": {"type": ["string", "null"]},
              "pass_rule": {"type": ["string", "null"]},
              "next_task": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
