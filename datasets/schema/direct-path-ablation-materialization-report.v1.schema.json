{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:direct-path-ablation-materialization-report:v1",
  "title": "Direct-path ablation materialization report",
  "description": "Content-addressed software receipt for a replay-validated mathematical same-path ablation. It does not claim a physical blocker or channel qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "qualification_status",
    "physical_blocker_modeled",
    "rt_generation_executed",
    "source_bundle_sha256",
    "derived_bundle_sha256",
    "derived_manifest_path",
    "path_table_sha256",
    "split_registry_sha256",
    "parent_subject_id",
    "base_child_id",
    "ablated_child_id",
    "split",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "umcd.direct_path_ablation_materialization_report.v1"},
    "status": {"const": "PASS_SOFTWARE_REPLAY"},
    "qualification_status": {"const": "NOT_QUALIFIED"},
    "physical_blocker_modeled": {"const": false},
    "rt_generation_executed": {"const": false},
    "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "derived_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "derived_manifest_path": {"type": "string", "minLength": 1},
    "path_table_sha256": {"$ref": "#/$defs/sha256"},
    "split_registry_sha256": {"$ref": "#/$defs/sha256"},
    "parent_subject_id": {"type": "string", "minLength": 1},
    "base_child_id": {"type": "string", "minLength": 1},
    "ablated_child_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "calibration", "test"]},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
