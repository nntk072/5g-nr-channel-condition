{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g3-path-equivalence-roster-diagnostic:v1",
  "title": "G3 Path Equivalence Roster Diagnostic",
  "description": "Diagnostic-only per-independent-episode path-class coverage; this record cannot admit or qualify a model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "admission_possible",
    "coverage_criterion",
    "joint_acceptance_family",
    "expected_episode_count",
    "observed_episode_count",
    "all_expected_episodes_pass",
    "strata",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "loslab.g3_path_equivalence_roster_diagnostic.v1"
    },
    "status": {
      "enum": [
        "ROSTER_PATH_COVERAGE_DIAGNOSTIC_PASS",
        "ROSTER_PATH_COVERAGE_DIAGNOSTIC_FAIL",
        "ROSTER_PATH_COVERAGE_DIAGNOSTIC_UNRESOLVED"
      ]
    },
    "admission_possible": {
      "const": false
    },
    "coverage_criterion": {
      "const": 0.95
    },
    "joint_acceptance_family": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family_id", "family_sha256"],
          "properties": {
            "family_id": { "type": "string", "minLength": 1 },
            "family_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "expected_episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "observed_episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "all_expected_episodes_pass": {
      "type": "boolean"
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "condition",
          "episodes",
          "coverage_pass",
          "coverage_fail",
          "unresolved"
        ],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "condition": { "enum": ["LOS", "NLOS"] },
          "episodes": { "type": "integer", "minimum": 1 },
          "coverage_pass": { "type": "integer", "minimum": 0 },
          "coverage_fail": { "type": "integer", "minimum": 0 },
          "unresolved": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "condition",
          "episode_id",
          "class_coverage_status",
          "candidate_bidirectional_coverage",
          "challenger_bidirectional_coverage"
        ],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "condition": { "enum": ["LOS", "NLOS"] },
          "episode_id": { "type": "string", "minLength": 1 },
          "class_coverage_status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNRESOLVED_NO_RELEVANT_CLASSES",
              "NOT_ASSESSABLE_NO_CLASSES"
            ]
          },
          "candidate_bidirectional_coverage": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "challenger_bidirectional_coverage": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
