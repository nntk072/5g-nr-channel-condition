#!/usr/bin/env python3
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[2]
REQUIRED = [
    "AGENTS.md",
    ".agents/architecture.md",
    ".agents/commands.md",
    ".agents/rules/core-execution.md",
    ".agents/rules/delegation.md",
    ".agents/rules/context-management.md",
    ".agents/rules/research-integrity.md",
    ".agents/rules/qualification-gates.md",
    ".agents/rules/validation-routing.md",
    ".agents/rules/ci-verification.md",
    ".agents/rules/resource-safety.md",
    ".agents/rules/security.md",
    ".agents/rules/git-permissions.md",
]
EXPECTED_ROLES = {
    "architect",
    "dataset_engineer",
    "propagation_engineer",
    "nr_phy_receiver_engineer",
    "ml_evaluation_engineer",
    "scientific_evidence_engineer",
    "ci_quality_engineer",
    "resource_engineer",
    "qa_engineer",
    "independent_reviewer",
}
FORBIDDEN = ("metatrader", "mt5", "broker", "quantitative-rl", "/scratch/work")
ALLOWED_TRIGGERS = {"always_on", "model_decision"}
ROLE_PACKAGE_MARKERS = {
    "architect": ("agent architecture",),
    "dataset_engineer": ("`datasets/`",),
    "propagation_engineer": ("`propagation/`", "`scenes/`"),
    "nr_phy_receiver_engineer": ("`receivers/`",),
    "ml_evaluation_engineer": ("`models/`", "`learning/`", "`evaluation/`"),
    "scientific_evidence_engineer": ("`artifacts/`",),
    "ci_quality_engineer": ("`.github/workflows/`", "`tools/check`"),
    "resource_engineer": ("`compute/`",),
    "qa_engineer": ("assigned tests",),
    "independent_reviewer": ("read-only",),
}
errors = []
for rel in REQUIRED:
    if not (ROOT / rel).is_file():
        errors.append(f"missing required agent rule file: {rel}")
role_paths = sorted((ROOT / ".agents/agents").glob("*.md"))
roles = {path.stem for path in role_paths}
if roles != EXPECTED_ROLES:
    errors.append(f"canonical role set mismatch: {sorted(roles)}")
declared_role_ids = []
for path in role_paths:
    text = path.read_text(encoding="utf-8")
    match = re.search(r"Canonical role ID `([^`]+)`", text)
    if match is None:
        errors.append(f"role file does not declare a canonical role ID: {path.relative_to(ROOT)}")
        continue
    declared_role_ids.append(match.group(1))
    if match.group(1) != path.stem:
        errors.append(f"role ID/file mismatch in {path.relative_to(ROOT)}")
if len(declared_role_ids) != len(set(declared_role_ids)):
    errors.append("duplicate canonical role IDs")

for path in sorted((ROOT / ".agents/rules").glob("*.md")):
    if path.name == "README.md":
        continue
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        errors.append(f"missing rule frontmatter: {path.relative_to(ROOT)}")
        continue
    try:
        _, frontmatter, _ = text.split("---", 2)
        value = yaml.safe_load(frontmatter)
    except (ValueError, yaml.YAMLError):
        errors.append(f"invalid rule frontmatter: {path.relative_to(ROOT)}")
        continue
    if not isinstance(value, dict) or set(value) != {"trigger", "description"}:
        errors.append(f"invalid rule frontmatter keys: {path.relative_to(ROOT)}")
        continue
    if value["trigger"] not in ALLOWED_TRIGGERS:
        errors.append(f"invalid rule trigger in {path.relative_to(ROOT)}")
    if not isinstance(value["description"], str) or not value["description"].strip():
        errors.append(f"missing rule description in {path.relative_to(ROOT)}")
for path in [ROOT / "AGENTS.md", *sorted((ROOT / ".agents").rglob("*.md"))]:
    text = path.read_text(encoding="utf-8")
    lowered = text.lower()
    for forbidden in FORBIDDEN:
        if forbidden in lowered:
            errors.append(f"forbidden reference {forbidden!r} in {path.relative_to(ROOT)}")
    for target in re.findall(r"\[[^\]]+\]\(([^)]+)\)", text):
        if "://" in target or target.startswith("#"):
            continue
        resolved = (path.parent / target.split("#", 1)[0]).resolve()
        if not resolved.exists():
            errors.append(f"broken local link in {path.relative_to(ROOT)}: {target}")
agents = (ROOT / "AGENTS.md").read_text(encoding="utf-8")
for marker in (
    "REQUIREMENT_LEDGER.json",
    "EXECUTION_QUEUE.md",
    "scientific qualification",
    "Production D1",
    "path-oracle",
    "Signed split",
    "Phase gauge",
    "G3 receiver-impact",
    "negative G4",
    "redistribution permission",
):
    if marker not in agents:
        errors.append(f"AGENTS.md missing invariant marker {marker!r}")
delegation = (ROOT / ".agents/rules/delegation.md").read_text(encoding="utf-8")
for role, markers in ROLE_PACKAGE_MARKERS.items():
    if f"`{role}`" not in delegation:
        errors.append(f"delegation map missing canonical role {role}")
    for marker in markers:
        if marker not in delegation:
            errors.append(f"delegation map missing reviewed ownership marker {role}: {marker}")
if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)
print("agent rules valid")
