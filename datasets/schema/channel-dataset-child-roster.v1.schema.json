{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umcd.example/schemas/channel-dataset-child-roster.v1.schema.json",
  "title": "UMCD ChannelDataset frozen split child roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "child_kind", "bindings"],
  "properties": {
    "schema": {"const": "umcd.channel_dataset_child_roster.v1"},
    "child_kind": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["child_id", "parent_subject_id", "child_kind"],
        "properties": {
          "child_id": {"type": "string", "minLength": 1},
          "parent_subject_id": {"type": "string", "minLength": 1},
          "child_kind": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
