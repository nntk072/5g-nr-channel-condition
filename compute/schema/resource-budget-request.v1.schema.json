{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/compute/resource-budget-request.v1.schema.json",
  "title": "Measurement-driven research resource-budget request v1",
  "type": "object",
  "required": ["schema", "request_id", "measurement_batch_id", "environment_sha256", "runtime_environment", "headroom_factor", "strata"],
  "properties": {
    "schema": {"const": "loslab.resource_budget_request.v1"},
    "request_id": {"$ref": "#/$defs/id"},
    "measurement_batch_id": {"$ref": "#/$defs/id"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_environment": {"$ref": "#/$defs/runtimeEnvironment"},
    "headroom_factor": {"type": "number", "minimum": 2.0, "maximum": 3.0},
    "strata": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/stratum"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeEnvironment": {
      "type": "object",
      "required": ["platform", "machine", "python_version", "numpy_version", "sionna_version", "torch_version", "solver_backend", "accelerator", "accelerator_driver", "accelerator_runtime"],
      "properties": {
        "platform": {"$ref": "#/$defs/id"},
        "machine": {"$ref": "#/$defs/id"},
        "python_version": {"$ref": "#/$defs/id"},
        "numpy_version": {"$ref": "#/$defs/id"},
        "sionna_version": {"$ref": "#/$defs/id"},
        "torch_version": {"$ref": "#/$defs/id"},
        "solver_backend": {"$ref": "#/$defs/id"},
        "accelerator": {"$ref": "#/$defs/id"},
        "accelerator_driver": {"$ref": "#/$defs/id"},
        "accelerator_runtime": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    },
    "stratum": {
      "type": "object",
      "required": ["stratum_id", "family_id", "planned_units", "pilot_observations"],
      "properties": {
        "stratum_id": {"$ref": "#/$defs/id"},
        "family_id": {"$ref": "#/$defs/id"},
        "planned_units": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "pilot_observations": {
          "type": "array", "minItems": 10, "maxItems": 100,
          "items": {"$ref": "#/$defs/observation"}
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "condition_id", "scene_family_id", "scene_id", "link_id", "configuration_sha256", "measurement_record_sha256",
        "solver_runtime_s", "receiver_runtime_s", "preprocessing_runtime_s",
        "downstream_runtime_s", "gpu_peak_memory_bytes", "raw_path_bytes",
        "cfr_bytes", "waveform_bytes", "manifest_bytes", "other_artifact_bytes"
      ],
      "properties": {
        "condition_id": {"$ref": "#/$defs/id"},
        "scene_family_id": {"$ref": "#/$defs/id"},
        "scene_id": {"$ref": "#/$defs/id"},
        "link_id": {"$ref": "#/$defs/id"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "measurement_record_sha256": {"$ref": "#/$defs/sha256"},
        "solver_runtime_s": {"type": "number", "minimum": 0},
        "receiver_runtime_s": {"type": "number", "minimum": 0},
        "preprocessing_runtime_s": {"type": "number", "minimum": 0},
        "downstream_runtime_s": {"type": "number", "minimum": 0},
        "gpu_peak_memory_bytes": {"type": "integer", "minimum": 0},
        "raw_path_bytes": {"type": "integer", "minimum": 0},
        "cfr_bytes": {"type": "integer", "minimum": 0},
        "waveform_bytes": {"type": "integer", "minimum": 0},
        "manifest_bytes": {"type": "integer", "minimum": 0},
        "other_artifact_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
