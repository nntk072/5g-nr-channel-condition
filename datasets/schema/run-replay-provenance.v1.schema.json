{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/run-replay-provenance.v1.schema.json",
  "title": "Run replay provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "qualification_status", "created_utc", "command", "source",
    "config_sha256", "inputs", "backend_identity", "backend_identity_sha256",
    "rng_streams", "attempt", "state", "state_changed_utc", "failure", "contract_sha256"
  ],
  "properties": {
    "schema": {"const": "loslab.run_replay_provenance.v1"},
    "qualification_status": {"const": "NOT_QUALIFIED"},
    "created_utc": {"type": "string", "minLength": 1},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "source"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["git_commit", "git_commit_status", "package_source_sha256"],
      "properties": {
        "git_commit": {"type": "string", "minLength": 1},
        "git_commit_status": {"enum": ["bound", "unavailable"]},
        "package_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "backend_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_device", "platform", "dependencies"],
      "properties": {
        "requested_device": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "backend_identity_sha256": {"$ref": "#/$defs/sha256"},
    "rng_streams": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "library", "algorithm", "seed_material", "derived_seed", "purpose"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "library": {"type": "string", "minLength": 1},
          "algorithm": {"type": "string", "minLength": 1},
          "seed_material": {
            "type": "array", "minItems": 1,
            "items": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
          },
          "derived_seed": {
            "oneOf": [
              {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
              {"type": "null"}
            ]
          },
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "retry_of_manifest_sha256"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "retry_of_manifest_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "state": {"enum": ["running", "complete", "failed"]},
    "state_changed_utc": {"type": "string", "minLength": 1},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["error_type", "message", "stage"],
          "properties": {
            "error_type": {"type": "string", "minLength": 1},
            "message": {"type": "string"},
            "stage": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
