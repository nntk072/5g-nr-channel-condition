{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g4-standard-reference-audit:v1",
  "title": "G4 Standard Reference Byte Audit Report",
  "description": "Reports exact source-byte identity checks only; never asserts G4 conformance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "qualification_status",
    "manifest_sha256",
    "source_count",
    "sources",
    "interpretation"
  ],
  "properties": {
    "schema": { "const": "loslab.g4_standard_reference_audit.v1" },
    "status": { "const": "PASS_REFERENCE_SOURCE_BYTES_ONLY" },
    "qualification_status": { "const": "NOT_QUALIFIED" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_count": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "filename", "sha256", "size_bytes", "status"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
          "status": { "const": "PASS_EXACT_REFERENCE_BYTES" }
        }
      }
    },
    "interpretation": { "type": "string", "minLength": 1 }
  }
}
