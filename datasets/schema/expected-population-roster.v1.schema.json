{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:expected-population-roster:v1",
  "title": "Expected population outcome roster v1",
  "type": "object",
  "required": ["schema", "roster_id", "units"],
  "properties": {
    "schema": {"const": "loslab.expected_population_roster.v1"},
    "roster_id": {"$ref": "#/$defs/id"},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "unit": {
      "type": "object",
      "required": ["unit_id", "family_id", "domain_id", "independent_group_id", "disposition", "reason"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/id"},
        "family_id": {"$ref": "#/$defs/id"},
        "domain_id": {"$ref": "#/$defs/id"},
        "independent_group_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["included", "excluded", "rejected", "no_path", "empty"]},
        "reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
