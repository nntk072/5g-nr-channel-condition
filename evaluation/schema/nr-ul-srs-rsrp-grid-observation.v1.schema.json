{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/evaluation/nr-ul-srs-rsrp-grid-observation.v1.schema.json",
  "title": "NR UL SRS-RSRP calibrated receive-grid observation v1",
  "type": "object",
  "required": [
    "schema", "status", "measurement_report", "received_grid_sha256",
    "mapped_resource_sha256", "power_scale_w_per_grid_unit_squared",
    "power_calibration_sha256", "received_re_power_includes_noise_and_interference",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "loslab.nr_ul_srs_rsrp_grid_observation.v1"},
    "status": {"const": "OBSERVED_NOT_QUALIFIED"},
    "measurement_report": {
      "type": "object",
      "required": ["schema", "status", "measurement", "receiver_branch_measurements"],
      "properties": {
        "schema": {"const": "loslab.nr_ul_srs_rsrp_report.v1"},
        "status": {"enum": ["MEASURED", "ZERO_POWER_DIAGNOSTIC"]},
        "measurement": {"const": "UL_SRS_RSRP"},
        "receiver_branch_measurements": {"type": "array", "minItems": 1}
      }
    },
    "received_grid_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapped_resource_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "power_scale_w_per_grid_unit_squared": {"type": "number", "exclusiveMinimum": 0},
    "power_calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "received_re_power_includes_noise_and_interference": {"const": true},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
