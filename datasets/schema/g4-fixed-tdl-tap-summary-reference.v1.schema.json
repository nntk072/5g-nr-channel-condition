{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g4-fixed-tdl-tap-summary-reference:v1",
  "title": "G4 Fixed TDL Tap Summary References",
  "description": "ETSI Annex B table-summary targets for deterministic adapter checks. Tap count denotes resolved delay clusters; LOS TDL-D specular and diffuse first components share a zero-delay cluster. This is not a conformance verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "standard",
    "version",
    "source_id",
    "source_sha256",
    "source_url",
    "reference_scope",
    "status",
    "profiles",
    "interpretation"
  ],
  "properties": {
    "schema": { "const": "loslab.g4_fixed_tdl_tap_summary_reference.v1" },
    "standard": { "const": "3GPP TS 38.101-4" },
    "version": { "const": "19.2.2" },
    "source_id": { "const": "ts-138101-4-v19.2.2" },
    "source_sha256": {
      "const": "b3c6a73c7a40219e7270c08c7a57c84cb46f6757b303a64ec768ba04a6079e81"
    },
    "source_url": {
      "const": "https://www.etsi.org/deliver/etsi_ts/138100_138199/13810104/19.02.02_60/ts_13810104v190202p.pdf"
    },
    "reference_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "const": "SUMMARY_REFERENCE_ONLY_NOT_CONFORMANCE_QUALIFICATION" },
    "profiles": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_model",
          "has_los_component",
          "source_tables",
          "tap_count",
          "maximum_excess_delay_ns",
          "delay_resolution_ns",
          "minimum_channel_bandwidth_hz_exclusive"
        ],
        "properties": {
          "profile_model": { "enum": ["A10", "A30", "B100", "C60", "C300", "D10", "D30"] },
          "has_los_component": { "type": "boolean" },
          "source_tables": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^B\\.2\\.1\\.[12]-[1-6]$" }
          },
          "tap_count": { "type": "integer", "minimum": 1 },
          "maximum_excess_delay_ns": { "type": "integer", "minimum": 0 },
          "delay_resolution_ns": { "enum": [2, 5] },
          "minimum_channel_bandwidth_hz_exclusive": {
            "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
          }
        }
      }
    },
    "interpretation": { "type": "string", "minLength": 1 }
  }
}
