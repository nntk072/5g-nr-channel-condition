{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/evaluation/nr-ul-srs-rsrp-network-observation.v1.schema.json",
  "title": "NR UL SRS-RSRP noisy network-grid observation v1",
  "type": "object",
  "required": [
    "schema", "status", "receiver_index", "transmitter_ids",
    "measurement_occasion_count", "receiver_branch_count", "noise_seed",
    "noise_variance_w_per_re", "received_grid_sha256",
    "mapped_resource_sha256", "noise_grid_sha256",
    "transmitter_contributions_sha256", "measurement_report", "limitations"
  ],
  "properties": {
    "schema": {"const": "loslab.nr_ul_srs_rsrp_network_observation.v1"},
    "status": {"const": "OBSERVED_NOT_QUALIFIED"},
    "receiver_index": {"type": "integer", "minimum": 0},
    "transmitter_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
    },
    "measurement_occasion_count": {"type": "integer", "minimum": 1},
    "receiver_branch_count": {"type": "integer", "minimum": 1},
    "noise_seed": {"type": "integer", "minimum": 0},
    "noise_variance_w_per_re": {
      "type": "array", "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    },
    "received_grid_sha256": {"$ref": "#/$defs/sha256"},
    "mapped_resource_sha256": {"$ref": "#/$defs/sha256"},
    "noise_grid_sha256": {"$ref": "#/$defs/sha256"},
    "transmitter_contributions_sha256": {"$ref": "#/$defs/sha256"},
    "measurement_report": {
      "type": "object",
      "required": ["schema", "status", "measurement", "receiver_branch_measurements"],
      "properties": {
        "schema": {"const": "loslab.nr_ul_srs_rsrp_report.v1"},
        "status": {"enum": ["MEASURED", "ZERO_POWER_DIAGNOSTIC"]},
        "measurement": {"const": "UL_SRS_RSRP"},
        "receiver_branch_measurements": {"type": "array", "minItems": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
