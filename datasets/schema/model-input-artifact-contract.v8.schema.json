{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:model-input-artifact-contract:v8",
  "title": "Metadata-only leakage-control model input artifact contract v8",
  "type": "object",
  "required": [
    "schema",
    "model_sha256",
    "feature_contract",
    "feature_contract_sha256",
    "training_input_files",
    "split"
  ],
  "properties": {
    "schema": {
      "const": "loslab.model_input_artifact_contract.v8"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "feature_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "feature_contract": {
      "type": "object",
      "required": [
        "schema",
        "method",
        "source_dataclass",
        "allowed_source_fields",
        "excluded_truth_and_metadata_fields",
        "target_field_used_for_supervision_only",
        "feature_transform",
        "feature_transform_implementation_sha256",
        "include_phase",
        "feature_dtype",
        "feature_shape_per_sample",
        "feature_matrix",
        "partition_feature_matrices",
        "source_revision",
        "run_config_sha256",
        "metadata_vocabulary_transform"
      ],
      "properties": {
        "schema": {
          "const": "loslab.model_input_feature_contract.v8"
        },
        "method": {
          "enum": [
            "metadata_only"
          ]
        },
        "source_dataclass": {
          "const": "datasets.channel.ChannelDataset"
        },
        "allowed_source_fields": {
          "const": [
            "group",
            "domain",
            "source"
          ]
        },
        "excluded_truth_and_metadata_fields": {
          "const": [
            "data.y",
            "data.metadata",
            "observed_cfr",
            "PathOracleTable",
            "target_values"
          ]
        },
        "target_field_used_for_supervision_only": {
          "const": "data.y"
        },
        "feature_transform": {
          "enum": [
            "train_vocabulary_group_domain_source_one_hot_v1"
          ]
        },
        "feature_transform_implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "include_phase": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "feature_dtype": {
          "enum": [
            "float32",
            "float64",
            "complex64",
            "complex128",
            "int8",
            "int16",
            "int32",
            "int64",
            "uint8",
            "uint16",
            "uint32",
            "uint64"
          ]
        },
        "feature_shape_per_sample": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "feature_matrix": {
          "type": "object",
          "required": [
            "sample_count",
            "dtype",
            "shape_per_sample",
            "sha256"
          ],
          "properties": {
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "dtype": {
              "type": "string",
              "minLength": 1
            },
            "shape_per_sample": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "partition_feature_matrices": {
          "type": "object",
          "required": [
            "train",
            "validation",
            "test"
          ],
          "properties": {
            "train": {
              "$ref": "#/$defs/partitionMatrix"
            },
            "validation": {
              "$ref": "#/$defs/partitionMatrix"
            },
            "test": {
              "$ref": "#/$defs/partitionMatrix"
            },
            "calibration": {
              "$ref": "#/$defs/partitionMatrix"
            }
          },
          "additionalProperties": false
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata_vocabulary_transform": {
          "type": "object",
          "required": [
            "schema",
            "algorithm",
            "implementation_sha256",
            "fields",
            "vocabulary",
            "vocabulary_sha256",
            "group_values_sha256",
            "domain_values_sha256",
            "source_values_sha256",
            "training_indices_sha256",
            "max_feature_cells",
            "unknown_category_behavior"
          ],
          "properties": {
            "schema": {
              "const": "loslab.metadata_only_vocabulary.v1"
            },
            "algorithm": {
              "const": "sorted_training_group_domain_source_one_hot_unknown_zero_v1"
            },
            "implementation_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "fields": {
              "const": [
                "domain",
                "group",
                "source"
              ]
            },
            "vocabulary": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "enum": [
                      "domain",
                      "group",
                      "source"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^\\S(?:.*\\S)?$"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "vocabulary_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "group_values_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "domain_values_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source_values_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "training_indices_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "max_feature_cells": {
              "type": "integer",
              "minimum": 1
            },
            "unknown_category_behavior": {
              "const": "all_zero_vector_for_unknown_field_value"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "training_input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "split": {
      "type": "object",
      "required": [
        "mode",
        "registry_sha256",
        "indices_sha256",
        "train_rows",
        "validation_rows",
        "test_rows"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "registry_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "indices_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "train_rows": {
          "type": "integer",
          "minimum": 1
        },
        "validation_rows": {
          "type": "integer",
          "minimum": 1
        },
        "test_rows": {
          "type": "integer",
          "minimum": 1
        },
        "calibration_rows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partitionMatrix": {
      "type": "object",
      "required": [
        "sample_count",
        "sha256"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
