{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.example/schemas/nr-pusch-intra-slot-hop-dmrs-plan.v1.schema.json",
  "title": "NR PUSCH intra-slot two-hop DM-RS timing plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "standard",
    "table",
    "mapping_type",
    "allocation_start_symbol",
    "first_hop_symbol_count",
    "second_hop_symbol_count",
    "dmrs_additional_position_configured",
    "dmrs_additional_position_used_per_hop",
    "dmrs_type_a_position",
    "first_hop_dmrs_symbols",
    "second_hop_dmrs_symbols",
    "scope",
    "qualification"
  ],
  "properties": {
    "schema": {"const": "loslab.nr_pusch_intra_slot_hop_dmrs_plan.v1"},
    "status": {"const": "DERIVED_NOT_QUALIFIED"},
    "standard": {"const": "3GPP TS 38.211 V19.2.0"},
    "table": {"const": "6.4.1.1.3-6"},
    "mapping_type": {"enum": ["A", "B"]},
    "allocation_start_symbol": {"type": "integer", "minimum": 0, "maximum": 13},
    "first_hop_symbol_count": {"type": "integer", "minimum": 1, "maximum": 7},
    "second_hop_symbol_count": {"type": "integer", "minimum": 1, "maximum": 7},
    "dmrs_additional_position_configured": {"type": "integer", "minimum": 0, "maximum": 3},
    "dmrs_additional_position_used_per_hop": {"enum": [0, 1]},
    "dmrs_type_a_position": {"type": ["integer", "null"], "enum": [2, 3, null]},
    "first_hop_dmrs_symbols": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 13}
    },
    "second_hop_dmrs_symbols": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 13}
    },
    "scope": {"const": "single_symbol_dmrs_two_hop_time_positions_only"},
    "qualification": {"const": "NOT_QUALIFIED"}
  }
}
