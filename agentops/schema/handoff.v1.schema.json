{
  "$id": "nr-agentops.handoff.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "blockers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "changed_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "changed_files": {
      "items": {"type": "string"},
      "type": "array"
    },
    "checks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "engineering_status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "limitations": {
      "items": {"type": "string"},
      "type": "array"
    },
    "next_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_task_id": {
      "type": ["string", "null"]
    },
    "review": {
      "type": "object"
    },
    "review_verdict": {
      "enum": ["APPROVE", "REQUEST_CHANGES", "UNABLE_TO_VERIFY"]
    },
    "result": {
      "enum": ["DONE", "PARTIAL", "BLOCKED", "FAILED"]
    },
    "schema": {
      "const": "nr-agentops.handoff.v1"
    },
    "scientific_disposition": {
      "enum": ["NOT_APPLICABLE", "NOT_QUALIFIED"],
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "task_card_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "unresolved_requirements": {
      "items": {"type": "string"},
      "type": "array"
    },
    "verification_receipt": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "task_id",
    "base_sha",
    "result",
    "changed_files",
    "source_digest",
    "verification_receipt",
    "review_verdict",
    "unresolved_requirements",
    "next_task_id",
    "limitations",
    "engineering_status",
    "scientific_disposition",
    "source_revision",
    "task_card_sha256",
    "changed_paths",
    "checks",
    "review",
    "blockers",
    "next_task"
  ],
  "type": "object"
}
