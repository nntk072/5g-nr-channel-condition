{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nntk072.github.io/5g-nr-channel-condition/schema/umcd-episode-metadata.v1.schema.json",
  "title": "UMCD episode object metadata v1",
  "description": "JSON metadata stored beside numeric arrays in an immutable UMCD episode NPZ object. Optional alignment and split relation properties preserve compatibility with earlier v1 objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "episode_id",
    "split_group_id",
    "family_id",
    "carrier_hz",
    "frame_times_s",
    "has_pose_timeline",
    "arrays",
    "nodes",
    "links"
  ],
  "properties": {
    "schema": {"const": "umcd.episode.v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "split_group_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "split_leakage_relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "identity"],
        "properties": {
          "namespace": {
            "enum": [
              "asset_family",
              "site",
              "scene_realization",
              "trajectory_session",
              "capture_session",
              "counterfactual_family",
              "material_realization",
              "equipment_family",
              "spatial_buffer",
              "overlapping_time_window"
            ]
          },
          "identity": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
        }
      }
    },
    "carrier_hz": {"type": "number", "exclusiveMinimum": 0},
    "frame_times_s": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "has_pose_timeline": {"type": "boolean"},
    "pose_time_alignment": {"oneOf": [{"$ref": "#/$defs/timeAlignment"}, {"type": "null"}]},
    "source_time_alignment": {"oneOf": [{"$ref": "#/$defs/multiSourceAlignment"}, {"type": "null"}]},
    "arrays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["array_id", "polarization_per_element", "port_ids"],
        "properties": {
          "array_id": {"type": "string", "minLength": 1},
          "polarization_per_element": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "port_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "role", "array_id", "position_world_m", "rf_chain_count"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["gnb", "ue", "relay", "interferer", "other"]},
          "array_id": {"type": "string", "minLength": 1},
          "position_world_m": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
          "rf_chain_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link_id", "tx_node_id", "rx_node_id", "tx_port_indices", "rx_port_indices", "direction", "role"],
        "properties": {
          "link_id": {"type": "string", "minLength": 1},
          "tx_node_id": {"type": "string", "minLength": 1},
          "rx_node_id": {"type": "string", "minLength": 1},
          "tx_port_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "rx_port_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "direction": {"enum": ["downlink", "uplink", "sidelink", "other"]},
          "role": {"enum": ["serving", "interfering", "sounding", "other"]}
        }
      }
    }
  },
  "$defs": {
    "timeAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "reference_times_s", "observed_times_s", "tolerance_s", "observed_indices", "residuals_s", "unmatched_reference_indices", "unmatched_observed_indices", "complete"],
      "properties": {
        "schema": {"const": "umcd.time_axis_alignment.v1"},
        "method": {"const": "unique_match_within_absolute_tolerance_no_interpolation"},
        "reference_times_s": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "observed_times_s": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "tolerance_s": {"type": "number", "minimum": 0},
        "observed_indices": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}},
        "residuals_s": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "number"}, {"type": "null"}]}},
        "unmatched_reference_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "unmatched_observed_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "complete": {"type": "boolean"}
      }
    },
    "multiSourceAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "reference_times_s", "sources", "complete"],
      "properties": {
        "schema": {"const": "umcd.multi_source_time_alignment.v1"},
        "method": {"const": "independent_unique_match_per_source_no_interpolation"},
        "reference_times_s": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "alignment"], "properties": {"source_id": {"type": "string", "minLength": 1}, "alignment": {"$ref": "#/$defs/timeAlignment"}}}},
        "complete": {"type": "boolean"}
      }
    }
  }
}
