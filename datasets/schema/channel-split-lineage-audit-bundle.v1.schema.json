{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/channel-split-lineage-audit-bundle.v1.schema.json",
  "title": "Channel split lineage audit bundle v1",
  "description": "Structural contract shared by historical and current versioned channel split lineage audit bundles. This validates report shape, not split independence or scientific qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "spatial_buffer_m",
    "identity_derivation",
    "input_completeness",
    "inputs",
    "lineage",
    "subjects",
    "interpretation"
  ],
  "properties": {
    "schema": {
      "enum": [
        "loslab.channel_split_lineage_audit_bundle.v1",
        "loslab.channel_split_lineage_audit_bundle.v2",
        "loslab.channel_split_lineage_audit_bundle.v3",
        "loslab.channel_split_lineage_audit_bundle.v4",
        "loslab.channel_split_lineage_audit_bundle.v5",
        "loslab.channel_split_lineage_audit_bundle.v6",
        "loslab.channel_split_lineage_audit_bundle.v7",
        "loslab.channel_split_lineage_audit_bundle.v8",
        "loslab.channel_split_lineage_audit_bundle.v9",
        "loslab.channel_split_lineage_audit_bundle.v10"
      ]
    },
    "status": {"const": "NOT_QUALIFIED"},
    "spatial_buffer_m": {"type": "number", "minimum": 0},
    "identity_derivation": {"$ref": "#/$defs/identityDerivation"},
    "input_completeness": {"$ref": "#/$defs/inputCompleteness"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    },
    "lineage": {"type": "object"},
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id"],
        "properties": {"subject_id": {"type": "string", "minLength": 1}},
        "additionalProperties": true
      }
    },
    "interpretation": {"type": "string", "minLength": 1},
    "split_registry_verification": {"$ref": "#/$defs/splitRegistryVerification"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identityDerivation": {
      "type": "object",
      "required": [
        "mode",
        "datasets_upgraded_in_memory",
        "rows_upgraded_in_memory",
        "input_hashes_cover_original_bytes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "opt_in_complete_rt_legacy_metadata",
            "opt_in_historical_rt_scene_asset_reconstruction"
          ]
        },
        "datasets_upgraded_in_memory": {"type": "array", "items": {"type": "string"}},
        "rows_upgraded_in_memory": {"type": "integer", "minimum": 0},
        "input_hashes_cover_original_bytes": {"const": true}
      },
      "additionalProperties": true
    },
    "inputCompleteness": {
      "type": "object",
      "required": ["status", "authority"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "splitRegistryVerification": {
      "type": "object",
      "required": [
        "status",
        "schema",
        "registry_sha256",
        "signer_id",
        "signature_namespace",
        "registry_file_sha256",
        "signature_sha256",
        "allowed_signers_sha256",
        "parent_roster_audit",
        "spatiotemporal_audit",
        "children_audited",
        "child_bindings_verified",
        "child_artifact_existence_verified",
        "child_artifact_bytes_verified",
        "child_artifact_semantic_rows_verified",
        "child_artifact_semantic_count",
        "child_artifact_byte_only_count",
        "child_artifact_trajectory_sample_count",
        "child_artifact_trajectory_count",
        "child_artifact_episode_count",
        "child_artifact_scenario_gbsm_run_count",
        "child_artifact_scenario_gbsm_parent_count",
        "complete_split_integrity_audit",
        "child_roster_audits",
        "child_artifact_roster_audits"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS_SIGNED_COMPLETE_SPLIT_INTEGRITY",
            "PASS_SIGNED_PARENT_FOOTPRINT_CHILD_BINDINGS_AND_ARTIFACT_BYTES",
            "PASS_SIGNED_PARENT_FOOTPRINT_CHILD_BINDINGS_AND_SEMANTIC_ARTIFACT_ROWS",
            "PASS_SIGNED_PARENT_FOOTPRINT_AND_CHILD_BINDING_ROSTERS",
            "PASS_SIGNED_PARENT_AND_FOOTPRINT_AUDIT"
          ]
        },
        "schema": {"type": "string", "minLength": 1},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "signer_id": {"type": "string", "minLength": 1},
        "signature_namespace": {"type": "string", "minLength": 1},
        "registry_file_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_signers_sha256": {"$ref": "#/$defs/sha256"},
        "parent_roster_audit": {"type": "object"},
        "spatiotemporal_audit": {"type": "object"},
        "children_audited": {"type": "boolean"},
        "child_bindings_verified": {"type": "boolean"},
        "child_artifact_existence_verified": {"type": "boolean"},
        "child_artifact_bytes_verified": {"type": "boolean"},
        "child_artifact_semantic_rows_verified": {"type": "boolean"},
        "child_artifact_semantic_count": {"type": "integer", "minimum": 0},
        "child_artifact_byte_only_count": {"type": "integer", "minimum": 0},
        "child_artifact_trajectory_sample_count": {"type": "integer", "minimum": 0},
        "child_artifact_trajectory_count": {"type": "integer", "minimum": 0},
        "child_artifact_episode_count": {"type": "integer", "minimum": 0},
        "child_artifact_scenario_gbsm_run_count": {"type": "integer", "minimum": 0},
        "child_artifact_scenario_gbsm_parent_count": {"type": "integer", "minimum": 0},
        "complete_split_integrity_audit": {"type": "boolean"},
        "child_roster_audits": {"type": "array", "items": {"type": "object"}},
        "child_artifact_roster_audits": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "bytes", "rows"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "rows": {"type": "integer", "minimum": 0}
      }
    }
  }
}
