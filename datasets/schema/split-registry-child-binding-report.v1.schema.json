{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/split-registry-child-binding-report.v1.schema.json",
  "title": "Split registry child binding report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "qualification_status", "created_utc",
    "parent_registry_path", "parent_registry_sha256", "policy_sha256",
    "child_rosters", "child_binding_count", "bound_registry_sha256",
    "bound_registry_file_sha256", "source_identity", "command_argv"
  ],
  "properties": {
    "schema": { "const": "umcd.split_registry_child_binding_report.v1" },
    "status": { "const": "CANDIDATE_NOT_EXTERNALLY_REVIEWED" },
    "qualification_status": { "const": "NOT_QUALIFIED" },
    "created_utc": { "type": "string", "format": "date-time" },
    "parent_registry_path": { "type": "string", "minLength": 1 },
    "parent_registry_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "child_rosters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "child_kind", "binding_count"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 1 },
          "child_kind": { "type": "string", "minLength": 1 },
          "binding_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "child_binding_count": { "type": "integer", "minimum": 1 },
    "bound_registry_sha256": { "$ref": "#/$defs/sha256" },
    "bound_registry_file_sha256": { "$ref": "#/$defs/sha256" },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["git_revision", "package_source_sha256", "source_module_sha256", "runtime_versions"],
      "properties": {
        "git_revision": { "type": "string", "minLength": 1 },
        "package_source_sha256": { "$ref": "#/$defs/sha256" },
        "source_module_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "command_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
