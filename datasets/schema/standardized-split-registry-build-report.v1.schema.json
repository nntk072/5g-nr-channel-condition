{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/standardized-split-registry-build-report.v1.schema.json",
  "title": "Standardized channel split registry build report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "qualification_status", "created_utc",
    "registry_sha256", "registry_file_sha256", "policy_sha256",
    "policy_file_sha256", "inputs", "lineage", "source_identity", "command_argv"
  ],
  "properties": {
    "schema": { "const": "umcd.standardized_split_registry_build_report.v1" },
    "status": { "const": "CANDIDATE_NOT_EXTERNALLY_REVIEWED" },
    "qualification_status": { "const": "NOT_QUALIFIED" },
    "created_utc": { "type": "string", "format": "date-time" },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "registry_file_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "policy_file_sha256": { "$ref": "#/$defs/sha256" },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "run_id", "manifest_path", "manifest_sha256", "run_content_sha256", "draw_count", "record_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "run_content_sha256": { "$ref": "#/$defs/sha256" },
          "draw_count": { "type": "integer", "minimum": 1 },
          "record_sha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } }
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "qualification_status", "run_count", "draw_count", "run_ids_sha256", "subject_roster_sha256", "partition_roster_sha256", "source_families", "policy_sha256", "registry_sha256", "parent_counts_by_split"],
      "properties": {
        "schema": { "const": "umcd.standardized_split_lineage.v1" },
        "status": { "const": "PASS_INPUT_SCOPED" },
        "qualification_status": { "const": "NOT_QUALIFIED" },
        "run_count": { "type": "integer", "minimum": 1 },
        "draw_count": { "type": "integer", "minimum": 1 },
        "run_ids_sha256": { "$ref": "#/$defs/sha256" },
        "subject_roster_sha256": { "$ref": "#/$defs/sha256" },
        "partition_roster_sha256": { "$ref": "#/$defs/sha256" },
        "source_families": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 1 } },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "registry_sha256": { "$ref": "#/$defs/sha256" },
        "parent_counts_by_split": { "type": "object", "minProperties": 3, "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["git_revision", "package_source_sha256", "source_module_sha256", "runtime_versions"],
      "properties": {
        "git_revision": { "type": "string", "minLength": 1 },
        "package_source_sha256": { "$ref": "#/$defs/sha256" },
        "source_module_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "command_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
