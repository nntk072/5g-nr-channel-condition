{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:near-duplicate-dispositions:v1",
  "title": "Signed UMCD near-duplicate dispositions v1",
  "type": "object",
  "required": [
    "schema",
    "inventory_sha256",
    "candidate_set_sha256",
    "reviewer_id",
    "dispositions"
  ],
  "properties": {
    "schema": {"const": "umcd.near_duplicate_dispositions.v1"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "outcome", "rationale", "evidence_sha256"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/sha256"},
          "outcome": {"enum": ["legitimate_similarity", "confirmed_leakage"]},
          "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_sha256": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/sha256"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
