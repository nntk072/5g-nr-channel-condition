{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g3.03-acquisition-package:v0.1",
  "title": "G3.03 Lab Acquisition Package Proposal v0.1",
  "description": "Unaccepted proposal for review. Does not define or alter the frozen evaluator contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "study_id", "created_utc", "files",
    "specimens", "acquisition_units", "calibrations", "samples", "fits",
    "angular_measurements", "csi_measurements", "rights", "attestations"
  ],
  "properties": {
    "schema_version": {"const": "g3.03-acquisition-package.v0.1"},
    "package_id": {"$ref": "#/$defs/id"},
    "study_id": {"$ref": "#/$defs/id"},
    "created_utc": {"$ref": "#/$defs/utc"},
    "package_description": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "specimens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/specimen"}},
    "acquisition_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "calibrations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/calibration"}},
    "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
    "fits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fit"}},
    "angular_measurements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/angular"}},
    "csi_measurements": {"type": "array", "items": {"$ref": "#/$defs/csi"}},
    "rights": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rights"}},
    "attestations": {
      "type": "object", "additionalProperties": false,
      "required": ["external_signature", "physical_independence", "calibration_truth", "rights_sufficiency"],
      "properties": {
        "external_signature": {"$ref": "#/$defs/attestation"},
        "physical_independence": {"$ref": "#/$defs/attestation"},
        "calibration_truth": {"$ref": "#/$defs/attestation"},
        "rights_sufficiency": {"$ref": "#/$defs/attestation"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "fileId": {"type": "string", "pattern": "^file\\.[a-z0-9._-]{1,58}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "fileRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/fileId"}},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["file_id", "path", "size_bytes", "media_type", "sha256", "role", "dependency_file_ids", "sample_ids", "specimen_ids", "calibration_ids"],
      "properties": {
        "file_id": {"$ref": "#/$defs/fileId"},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["raw", "calibrated", "calibration", "reference", "background", "repeat", "phase_reference", "specimen_provenance", "unit_provenance", "processing", "fit", "covariance", "rights", "attestation", "other"]},
        "dependency_file_ids": {"$ref": "#/$defs/fileRefs"},
        "sample_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "specimen_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "calibration_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "specimen": {
      "type": "object", "additionalProperties": false,
      "required": ["specimen_id", "material_claim", "composition", "thickness_m", "dimensions_m", "preparation", "condition", "provenance_file_ids"],
      "properties": {
        "specimen_id": {"$ref": "#/$defs/id"}, "material_claim": {"type": "string", "minLength": 1},
        "composition": {"type": "string", "minLength": 1}, "thickness_m": {"type": "number", "exclusiveMinimum": 0},
        "dimensions_m": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "preparation": {"type": "string", "minLength": 1}, "condition": {"type": "string", "minLength": 1},
        "provenance_file_ids": {"$ref": "#/$defs/fileRefs"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "specimen_id", "unit_kind", "provenance_file_ids", "independence_attestation_id"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/id"}, "specimen_id": {"$ref": "#/$defs/id"},
        "unit_kind": {"enum": ["independent_specimen_acquisition", "repositioned_acquisition", "repeat_scan"]},
        "provenance_file_ids": {"$ref": "#/$defs/fileRefs"}, "independence_attestation_id": {"$ref": "#/$defs/id"}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["calibration_id", "method", "reference_plane", "valid_from_utc", "valid_to_utc", "standard_file_ids", "run_file_ids", "processing_file_ids", "truth_attestation_id"],
      "properties": {
        "calibration_id": {"$ref": "#/$defs/id"}, "method": {"type": "string", "minLength": 1},
        "reference_plane": {"type": "string", "minLength": 1}, "valid_from_utc": {"$ref": "#/$defs/utc"},
        "valid_to_utc": {"$ref": "#/$defs/utc"}, "standard_file_ids": {"$ref": "#/$defs/fileRefs"},
        "run_file_ids": {"$ref": "#/$defs/fileRefs"}, "processing_file_ids": {"$ref": "#/$defs/fileRefs"},
        "truth_attestation_id": {"$ref": "#/$defs/id"}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "specimen_id", "unit_id", "calibration_id", "acquired_utc", "polarization", "incidence_zenith_deg", "frequency_hz", "measured_integrated_power_w", "file_ids"],
      "properties": {
        "sample_id": {"$ref": "#/$defs/id"}, "specimen_id": {"$ref": "#/$defs/id"},
        "unit_id": {"$ref": "#/$defs/id"}, "calibration_id": {"$ref": "#/$defs/id"},
        "acquired_utc": {"$ref": "#/$defs/utc"},
        "polarization": {"enum": ["V", "H", "RHCP", "LHCP"]},
        "incidence_zenith_deg": {"type": "number", "minimum": 0, "maximum": 180},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "measured_integrated_power_w": {"type": "number", "minimum": 0},
        "file_ids": {"$ref": "#/$defs/fileRefs"}
      }
    },
    "fit": {
      "type": "object", "additionalProperties": false,
      "required": ["fit_id", "specimen_id", "model_id", "model_sha256", "method", "software_file_ids", "parameters"],
      "properties": {
        "fit_id": {"$ref": "#/$defs/id"}, "specimen_id": {"$ref": "#/$defs/id"},
        "model_id": {"$ref": "#/$defs/id"}, "model_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string", "minLength": 1}, "software_file_ids": {"$ref": "#/$defs/fileRefs"},
        "parameters": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "estimate", "unit", "standard_uncertainty"],
            "properties": {
              "name": {"type": "string", "minLength": 1}, "estimate": {"type": "number"},
              "unit": {"type": "string", "minLength": 1}, "standard_uncertainty": {"type": "number", "minimum": 0},
              "covariance_file_id": {"$ref": "#/$defs/fileId"}
            }
          }
        }
      }
    },
    "matrix": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}},
    "angular": {
      "type": "object", "additionalProperties": false,
      "required": ["angular_id", "sample_id", "theta_edges_deg", "phi_edges_deg", "array_order", "power_semantics", "power_per_bin_w", "solid_angle_sr", "missing_bin_indices"],
      "properties": {
        "angular_id": {"$ref": "#/$defs/id"}, "sample_id": {"$ref": "#/$defs/id"},
        "theta_edges_deg": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 180}},
        "phi_edges_deg": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": -180, "maximum": 180}},
        "array_order": {"const": ["theta_bin", "phi_bin; azimuth varies fastest"]},
        "power_semantics": {"const": "integrated_power_per_bin"},
        "power_per_bin_w": {"$ref": "#/$defs/matrix"}, "solid_angle_sr": {"$ref": "#/$defs/matrix"},
        "missing_bin_indices": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "minItems": 2, "maxItems": 2}}
      }
    },
    "csi": {
      "type": "object", "additionalProperties": false,
      "required": ["csi_id", "sample_id", "axes", "shape", "rx_port_ids", "tx_port_ids", "subcarrier_indices", "subcarrier_frequency_offsets_hz", "ofdm_symbol_indices", "complex_order", "measured_complex", "predicted_complex", "delay_reference", "phase_reference", "phase_convention", "h_floor", "file_ids"],
      "properties": {
        "csi_id": {"$ref": "#/$defs/id"}, "sample_id": {"$ref": "#/$defs/id"},
        "axes": {"const": ["rx_port", "tx_port", "subcarrier", "ofdm_symbol"]},
        "shape": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 1}},
        "rx_port_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "tx_port_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "subcarrier_indices": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "subcarrier_frequency_offsets_hz": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "ofdm_symbol_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "complex_order": {"const": "C row-major; last axis varies fastest; each value is [real, imaginary]"},
        "measured_complex": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
        "predicted_complex": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
        "delay_reference": {"type": "string", "minLength": 1}, "phase_reference": {"type": "string", "minLength": 1},
        "phase_convention": {"type": "string", "minLength": 1},
        "h_floor": {
          "type": "object", "additionalProperties": false,
          "required": ["amplitude_linear", "method", "noise_input_file_ids"],
          "properties": {"amplitude_linear": {"type": "number", "minimum": 0}, "method": {"type": "string", "minLength": 1}, "noise_input_file_ids": {"$ref": "#/$defs/fileRefs"}}
        },
        "file_ids": {"$ref": "#/$defs/fileRefs"}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["rights_id", "rights_holder", "scope", "redistribution", "publication", "restrictions", "evidence_file_ids", "attestation_id"],
      "properties": {
        "rights_id": {"$ref": "#/$defs/id"}, "rights_holder": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"enum": ["raw", "calibrated", "derived", "figures", "specimen_images"]}},
        "redistribution": {"enum": ["allowed", "restricted", "prohibited", "unknown"]},
        "publication": {"enum": ["allowed", "restricted", "prohibited", "unknown"]},
        "restrictions": {"type": "array", "items": {"type": "string"}},
        "evidence_file_ids": {"$ref": "#/$defs/fileRefs"}, "attestation_id": {"$ref": "#/$defs/id"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["attestation_id", "claim", "signer_id", "signed_utc", "evidence_file_ids"],
      "properties": {
        "attestation_id": {"$ref": "#/$defs/id"}, "claim": {"type": "string", "minLength": 1},
        "signer_id": {"$ref": "#/$defs/id"}, "signed_utc": {"$ref": "#/$defs/utc"},
        "evidence_file_ids": {"$ref": "#/$defs/fileRefs"}
      }
    }
  }
}
