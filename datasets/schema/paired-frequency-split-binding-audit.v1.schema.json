{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:paired-frequency-split-binding-audit:v1",
  "title": "Paired-frequency split binding audit",
  "description": "Input-scoped evidence that both episode bundles in a paired-frequency manifest inherit one frozen network-scene parent in the supplied registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "pair_sha256", "registry_sha256", "parent_subject_id", "source_scene_id", "child_bindings", "audit_sha256"],
  "properties": {
    "schema": {"const": "umcd.paired_frequency_split_binding_audit.v1"},
    "status": {"const": "PASS_INPUT_SCOPED"},
    "pair_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "parent_subject_id": {"type": "string", "minLength": 1},
    "source_scene_id": {"type": "string", "minLength": 1},
    "child_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["child_id", "parent_subject_id", "child_kind", "split"],
        "properties": {
          "child_id": {"type": "string", "minLength": 1},
          "parent_subject_id": {"type": "string", "minLength": 1},
          "child_kind": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "validation", "calibration", "test"]}
        }
      }
    },
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
