{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:network-pusch-workflow-report:v1",
  "title": "Network waveform composition and PUSCH receiver workflow report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "implementation_sha256",
    "noise_seed",
    "composition_options_sha256",
    "composition_options",
    "input_sha256",
    "decode_report_sha256",
    "output_sha256",
    "boundary",
    "schema_sha256",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "umcd.network_pusch_receiver_workflow.v1"},
    "status": {"const": "OBSERVED_NOT_QUALIFIED"},
    "implementation_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "waveform_composition", "receiver_awgn", "pusch_decode"],
      "properties": {
        "workflow": {"$ref": "#/$defs/sha256"},
        "waveform_composition": {"$ref": "#/$defs/sha256"},
        "receiver_awgn": {"$ref": "#/$defs/sha256"},
        "pusch_decode": {"$ref": "#/$defs/sha256"}
      }
    },
    "noise_seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "composition_options_sha256": {"$ref": "#/$defs/sha256"},
    "composition_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_start_samples_sha256",
        "link_power_gain_linear_sha256",
        "link_cfo_hz_sha256",
        "link_initial_phase_rad_sha256",
        "link_fractional_delay_samples_sha256",
        "tx_phase_noise_linewidth_hz_sha256",
        "rx_phase_noise_linewidth_hz_sha256",
        "rx_iq_gain_imbalance_db_sha256",
        "rx_iq_phase_imbalance_rad_sha256",
        "link_filter_taps_sha256",
        "phase_noise_seed",
        "sample_rate_hz"
      ],
      "properties": {
        "link_start_samples_sha256": {"$ref": "#/$defs/sha256"},
        "link_power_gain_linear_sha256": {"$ref": "#/$defs/sha256"},
        "link_cfo_hz_sha256": {"$ref": "#/$defs/sha256"},
        "link_initial_phase_rad_sha256": {"$ref": "#/$defs/sha256"},
        "link_fractional_delay_samples_sha256": {"$ref": "#/$defs/sha256"},
        "tx_phase_noise_linewidth_hz_sha256": {"$ref": "#/$defs/sha256"},
        "rx_phase_noise_linewidth_hz_sha256": {"$ref": "#/$defs/sha256"},
        "rx_iq_gain_imbalance_db_sha256": {"$ref": "#/$defs/sha256"},
        "rx_iq_phase_imbalance_rad_sha256": {"$ref": "#/$defs/sha256"},
        "link_filter_taps_sha256": {"$ref": "#/$defs/sha256"},
        "phase_noise_seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelized_link_waveforms",
        "composed_source_contributions",
        "clean_receive_waveform",
        "noise_waveform",
        "noisy_receive_waveform",
        "noise_variance_w_per_sample",
        "noise_variance_w_per_re"
      ],
      "properties": {
        "channelized_link_waveforms": {"$ref": "#/$defs/sha256"},
        "composed_source_contributions": {"$ref": "#/$defs/sha256"},
        "clean_receive_waveform": {"$ref": "#/$defs/sha256"},
        "noise_waveform": {"$ref": "#/$defs/sha256"},
        "noisy_receive_waveform": {"$ref": "#/$defs/sha256"},
        "noise_variance_w_per_sample": {"$ref": "#/$defs/sha256"},
        "noise_variance_w_per_re": {"$ref": "#/$defs/sha256"}
      }
    },
    "decode_report_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["received_grid", "decoded_bits", "crc_ok"],
      "properties": {
        "received_grid": {"$ref": "#/$defs/sha256"},
        "decoded_bits": {"$ref": "#/$defs/sha256"},
        "crc_ok": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundary": {"const": "SOFTWARE_REPLAY_ONLY_NOT_RECEIVER_OR_CHANNEL_QUALIFICATION"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
