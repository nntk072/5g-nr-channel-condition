{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/g3-joint-evidence-run-verification.v1.schema.json",
  "title": "G3 Joint Evidence Run Verification Report v1",
  "description": "Strict report contract for bounded numerical replay. Every report remains NOT_QUALIFIED; signature verification does not establish trust custody, measurement truth, or scientific admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "qualification_status",
    "run_id",
    "manifest_signature_status",
    "signer_authorization_status",
    "signer_policy_signature_status",
    "signed_reviewer_admission_status",
    "signer_policy_custody",
    "runtime_identity_status",
    "runtime_inventory_signature_status",
    "runtime_inventory_binding_status",
    "report_schema_sha256",
    "errors",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "loslab.g3_joint_evidence_run_verification.v1"},
    "status": {"enum": ["INCONSISTENT", "PASS_INPUT_SCOPED_RECOMPUTATION"]},
    "qualification_status": {"const": "NOT_QUALIFIED"},
    "run_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"}]},
    "manifest_signature_status": {"enum": ["not_provided", "verified"]},
    "signer_authorization_status": {"enum": ["not_provided", "authorized_for_run_manifest_verification"]},
    "signer_policy_signature_status": {"enum": ["not_provided", "verified"]},
    "signed_reviewer_admission_status": {"enum": ["not_requested", "required", "signature_role_policy_and_contract_preflight_passed"]},
    "signer_policy_custody": {"const": "not_established_by_this_verifier"},
    "runtime_identity_status": {"enum": ["not_recorded", "recorded_self_reported_unattested"]},
    "runtime_inventory_signature_status": {"enum": ["not_provided", "verified"]},
    "runtime_inventory_binding_status": {"enum": ["not_provided", "verified"]},
    "report_schema_sha256": {"$ref": "#/$defs/sha256"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "manifest_signature_namespace": {"const": "loslab-g3-joint-run-manifest-v1@github.com"},
    "manifest_signer_id": {"type": "string", "minLength": 1},
    "manifest_signature_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_allowed_signers_sha256": {"$ref": "#/$defs/sha256"},
    "trust_file_custody": {"const": "not_established_by_this_verifier"},
    "signer_policy_signature_namespace": {"const": "loslab-g3-run-manifest-policy-v1@github.com"},
    "signer_policy_signer_id": {"type": "string", "minLength": 1},
    "signer_policy_detached_signature_sha256": {"$ref": "#/$defs/sha256"},
    "signer_policy_allowed_signers_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_signer_organization": {"type": "string", "minLength": 1},
    "manifest_signer_roles": {"type": "string", "minLength": 1},
    "trusted_signer_policy_id": {"type": "string", "minLength": 1},
    "trusted_signer_policy_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_inventory_signer_id": {"type": "string", "minLength": 1},
    "runtime_inventory_signature_sha256": {"$ref": "#/$defs/sha256"},
    "trusted_runtime_inventory_signers_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "branch_count": {"type": "integer", "minimum": 1},
    "evaluator_source_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "qualification_contract_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "qualification_contract_bound": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
