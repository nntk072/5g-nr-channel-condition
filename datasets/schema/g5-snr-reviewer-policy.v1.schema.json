{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umcd.example/schema/g5-snr-reviewer-policy.v1.schema.json",
  "title": "G5 SNR preregistration reviewer policy v1",
  "type": "object",
  "required": ["schema", "policy_id", "signers"],
  "properties": {
    "schema": {"const": "umcd.g5_snr_reviewer_policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["principal", "organization", "roles", "allowed_purposes"],
        "properties": {
          "principal": {"type": "string", "minLength": 1},
          "organization": {"type": "string", "minLength": 1},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "allowed_purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"const": "g5_ordered_impairments_snr_preregistration"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
