#!/usr/bin/env python3
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
ROLES = (
    "architect",
    "dataset_engineer",
    "propagation_engineer",
    "nr_phy_receiver_engineer",
    "ml_evaluation_engineer",
    "scientific_evidence_engineer",
    "ci_quality_engineer",
    "resource_engineer",
    "qa_engineer",
    "independent_reviewer",
)
FORBIDDEN = re.compile(r"(?i)(MetaTrader|\bMT5\b|broker|Quantitative-RL|/scratch/work)")


def main() -> int:
    errors = []
    canonical = ROOT / ".agents/rules/delegation.md"
    if not canonical.is_file():
        errors.append("missing canonical delegation rule")
    for role in ROLES:
        codex = ROOT / ".codex/agents" / f"{role}.toml"
        claude = ROOT / ".claude/agents" / f"{role}.md"
        for path in (codex, claude):
            if not path.is_file():
                errors.append(f"missing profile {path.relative_to(ROOT)}")
                continue
            text = path.read_text(encoding="utf-8")
            if role not in text:
                errors.append(
                    f"profile {path.relative_to(ROOT)} does not name canonical role {role}"
                )
            if ".agents/rules/delegation.md" not in text:
                errors.append(
                    f"profile {path.relative_to(ROOT)} does not link canonical delegation"
                )
            if FORBIDDEN.search(text):
                errors.append(f"forbidden reference in {path.relative_to(ROOT)}")
        if codex.is_file():
            try:
                data = tomllib.loads(codex.read_text(encoding="utf-8"))
            except tomllib.TOMLDecodeError:
                errors.append(f"invalid TOML profile {codex.relative_to(ROOT)}")
            else:
                expected = {
                    "role_id": role,
                    "canonical_delegation": ".agents/rules/delegation.md",
                    "intent": "bounded repository engineering",
                }
                if data != expected:
                    errors.append(f"unexpected Codex profile contract in {codex.relative_to(ROOT)}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"agent profiles valid ({len(ROLES)} canonical roles)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
