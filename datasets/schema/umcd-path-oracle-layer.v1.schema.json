{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nntk072.github.io/5g-nr-channel-condition/schema/umcd-path-oracle-layer.v1.schema.json",
  "title": "UMCD path-oracle content-layer metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "link_ids",
    "solve_status",
    "path_kind",
    "coefficient_convention",
    "optional_fields"
  ],
  "properties": {
    "schema": {"const": "umcd.path_oracle.v1"},
    "link_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "solve_status": {
      "type": "array",
      "items": {"enum": ["solved", "no_path", "solver_failure", "unconverged"]}
    },
    "path_kind": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "string", "minLength": 1}}
      ]
    },
    "coefficient_convention": {"type": "string", "minLength": 1},
    "optional_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doppler_hz",
        "aoa_azimuth_elevation_rad",
        "aod_azimuth_elevation_rad",
        "interaction_geometry",
        "interaction_vertex_frame"
      ],
      "properties": {
        "doppler_hz": {"type": "boolean"},
        "aoa_azimuth_elevation_rad": {"type": "boolean"},
        "aod_azimuth_elevation_rad": {"type": "boolean"},
        "interaction_geometry": {"type": "boolean"},
        "interaction_vertex_frame": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"interaction_geometry": {"const": true}}},
          "then": {"properties": {"interaction_vertex_frame": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"interaction_vertex_frame": {"type": "null"}}}
        }
      ]
    }
  }
}
