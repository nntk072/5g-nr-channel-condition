{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g4-cdl-e-covariance-replication:v1",
  "title": "G4 CDL-E fresh-seed covariance replication",
  "description": "One preregistered seed replication report. A pass is bounded evidence and never replaces the retained frozen failure or qualifies overall G4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "protocol", "date", "status", "error", "qualification_claim", "criteria_changed",
    "design", "seed_audit", "runtime", "provenance", "command", "claims", "summary", "scope"
  ],
  "properties": {
    "schema": {"const": "loslab.g4_cdl_e_covariance_replication.v1"},
    "protocol": {"const": "CDL_E_FRESH_SEED_REPLICATION_PROTOCOL_2026-11-12.md"},
    "date": {"type": "string", "format": "date"},
    "status": {"enum": ["PASS_WITHIN_BOUNDED_PROTOCOL_SCOPE", "FAIL", "INCOMPLETE"]},
    "error": {"type": ["string", "null"]},
    "qualification_claim": {"const": "none"},
    "criteria_changed": {"const": false},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile", "seed", "draw_count", "carrier_hz", "subcarrier_spacing_hz",
        "subcarrier_count", "delay_spread_s", "rx_element_count",
        "rx_element_spacing_wavelengths", "rx_orientation_rad", "familywise_alpha",
        "claim_count", "maximum_half_width"
      ],
      "properties": {
        "profile": {"const": "E"},
        "seed": {"const": 2823000},
        "draw_count": {"const": 8192},
        "carrier_hz": {"const": 3500000000.0},
        "subcarrier_spacing_hz": {"const": 30000.0},
        "subcarrier_count": {"const": 8},
        "delay_spread_s": {"const": 1e-7},
        "rx_element_count": {"const": 4},
        "rx_element_spacing_wavelengths": {"const": 0.5},
        "rx_orientation_rad": {"const": [0.0, 0.0, 0.0]},
        "familywise_alpha": {"const": 0.01},
        "claim_count": {"const": 16},
        "maximum_half_width": {"const": 0.05}
      }
    },
    "seed_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "scanned_file_count", "global_exclusivity_established"],
      "properties": {
        "path": {"const": "docs/research/CDL_E_FRESH_SEED_AUDIT_2026-11-12.json"},
        "sha256": {"pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "CLEAR_WITHIN_SCANNED_JSON_CORPUS"},
        "scanned_file_count": {"const": 2302},
        "global_exclusivity_established": {"const": false}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "sionna", "torch", "torch_cuda_build", "device"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "sionna": {"type": "string", "minLength": 1},
        "torch": {"type": "string", "minLength": 1},
        "torch_cuda_build": {"type": "string", "minLength": 1},
        "device": {"const": "cpu"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision", "clean_worktree_at_run_start", "runner_sha256", "evaluator_sha256",
        "native_test_sha256", "protocol_sha256", "schema_sha256", "reference_sha256",
        "profile_table_sha256", "profile_table_verified"
      ],
      "properties": {
        "git_revision": {"pattern": "^[0-9a-f]{40}$"},
        "clean_worktree_at_run_start": {"const": true},
        "runner_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "evaluator_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "native_test_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "protocol_sha256": {"const": "1fe62127efd1591bc2a0dcbfbff2fdebbbbdb219b2185e1f3f785b754899e6a3"},
        "schema_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "reference_sha256": {"const": "24ee2f8f73f26e27522a296a4a0860bdaa7f284e9138855666e09636bc97b090"},
        "profile_table_sha256": {"const": "04328f33d8d79b24aa3d0303fecb58b465ed7e13874930b05e76be0d97743480"},
        "profile_table_verified": {"type": "boolean"}
      }
    },
    "command": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name", "estimate", "reference", "standard_error", "interval", "half_width",
          "absolute_error", "contained", "precision_pass", "passed"
        ],
        "properties": {
          "name": {"pattern": "^(diag_[0-3]|(re|im)_[0-3][0-3])$"},
          "estimate": {"type": "number"},
          "reference": {"type": "number"},
          "standard_error": {"type": "number", "minimum": 0},
          "interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
          "half_width": {"type": "number", "minimum": 0},
          "absolute_error": {"type": "number", "minimum": 0},
          "contained": {"type": "boolean"},
          "precision_pass": {"type": "boolean"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_passed", "claims_failed", "maximum_absolute_error", "maximum_half_width"],
      "properties": {
        "claims_passed": {"type": "integer", "minimum": 0, "maximum": 16},
        "claims_failed": {"type": "integer", "minimum": 0, "maximum": 16},
        "maximum_absolute_error": {"type": ["number", "null"], "minimum": 0},
        "maximum_half_width": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "scope": {"type": "string", "minLength": 1}
  }
}
