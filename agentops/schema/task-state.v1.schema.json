{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nr-agentops.task-state.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "task_id", "task_card_sha256", "source_base_sha", "current_source_sha", "phase", "status", "attempt", "attempt_history", "owners", "start_utc", "last_update_utc", "validation_receipt_paths", "resource_authorization_digest", "provider_calls", "blocked_reason", "scientific_disposition"],
  "properties": {
    "schema": {"const": "nr-agentops.task-state.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "task_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workspace_root": {"type": "string", "minLength": 1},
    "phase": {"enum": ["PENDING", "PREFLIGHT", "IMPLEMENTING", "REVIEWING", "FIXING", "VERIFYING", "REPORTING", "DONE", "FAILED", "BLOCKED", "STALE_SOURCE", "NEEDS_HUMAN_APPROVAL", "DRY_RUN_ONLY"]},
    "status": {"enum": ["active", "done", "failed", "blocked", "stale_source", "needs_human_approval", "dry_run_only"]},
    "attempt": {"type": "integer", "minimum": 0}, "attempt_history": {"type": "array", "items": {"type": "object"}},
    "owners": {"type": "array", "items": {"type": "string"}}, "start_utc": {"type": "string"}, "last_update_utc": {"type": "string"},
    "validation_receipt_paths": {"type": "array", "items": {"type": "string"}},
    "resource_authorization_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "provider_calls": {"type": "array", "items": {"type": "object"}}, "blocked_reason": {"type": ["string", "null"]},
    "scientific_disposition": {"enum": ["NOT_APPLICABLE", "NOT_QUALIFIED"]}
  }
}
