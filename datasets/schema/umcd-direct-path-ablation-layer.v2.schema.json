{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.dev/schema/umcd-direct-path-ablation-layer.v2.schema.json",
  "title": "UMCD direct-path ablation layer metadata v2",
  "description": "Carrier-phase-bound same-path mathematical CFR ablation; not a physical blocker intervention.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_subject_id",
    "base_child_id",
    "ablated_child_id",
    "split",
    "path_table_sha256",
    "link_ids",
    "carrier_hz"
  ],
  "properties": {
    "schema": {"const": "umcd.direct_path_ablation.v2"},
    "parent_subject_id": {"type": "string", "minLength": 1},
    "base_child_id": {"type": "string", "minLength": 1},
    "ablated_child_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "minLength": 1},
    "path_table_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "link_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "carrier_hz": {"type": "number", "exclusiveMinimum": 0}
  }
}
