{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "nr-agentops.resource-authorization.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "task_id", "source_revision", "task_card_sha256", "resource_class", "host", "selected_device", "budget_report_sha256", "max_gpu_hours", "ram_ceiling_bytes", "disk_ceiling_bytes", "allowed_scheduler_argv", "expires_at_utc", "approved_by", "scientific_gate_authorized"],
  "properties": {
    "schema": {"const": "nr-agentops.resource-authorization.v1"}, "task_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "task_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_class": {"enum": ["native_smoke", "scientific_native", "production_d1"]}, "host": {"type": "string", "minLength": 1}, "selected_device": {"type": "string", "pattern": "^(cpu|cuda:(0|[1-9][0-9]*))$"},
    "budget_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "max_gpu_hours": {"type": "number", "minimum": 0},
    "ram_ceiling_bytes": {"type": "integer", "minimum": 1}, "disk_ceiling_bytes": {"type": "integer", "minimum": 1}, "allowed_scheduler_argv": {"type": "array", "items": {"type": "string"}},
    "expires_at_utc": {"type": "string"}, "approved_by": {"type": "string", "minLength": 1}, "scientific_gate_authorized": {"type": "boolean"}
  }
}
