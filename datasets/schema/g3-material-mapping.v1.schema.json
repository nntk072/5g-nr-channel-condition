{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loslab:schema:g3-material-mapping.v1",
  "title": "LoSLab G3 acquisition specimen to evaluator material mapping v1",
  "description": "Exact-byte mapping proposal from acquisition specimen identities and documented material claims to the evaluator's controlled material IDs. Structural consistency does not authenticate material identity or claim truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "material_mapping_id", "mapping_basis", "materials"],
  "properties": {
    "schema": {"const": "loslab.g3_material_mapping.v1"},
    "material_mapping_id": {"$ref": "#/$defs/id"},
    "mapping_basis": {"type": "string", "minLength": 1},
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/material"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "fileId": {"type": "string", "pattern": "^file\\.[a-z0-9._-]{1,58}$"},
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "specimen_ids", "material_claims", "evidence_file_ids"],
      "properties": {
        "material_id": {"$ref": "#/$defs/id"},
        "specimen_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "material_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_file_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileId"}
        }
      }
    }
  }
}
