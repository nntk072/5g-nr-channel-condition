{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/experiments/schema/capacity-sweep-manifest.v2.schema.json",
  "title": "Capacity sweep parent manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "created_utc",
    "config",
    "config_sha256",
    "inputs",
    "run_replay"
  ],
  "properties": {
    "schema": {"const": "loslab.capacity_sweep.v2"},
    "state": {"enum": ["running", "complete", "failed"]},
    "created_utc": {"type": "string", "minLength": 1},
    "completed_utc": {"type": "string", "minLength": 1},
    "failed_utc": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "config_sha256": {"$ref": "../../datasets/schema/run-replay-provenance.v1.schema.json#/$defs/sha256"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "../../datasets/schema/run-replay-provenance.v1.schema.json#/$defs/sha256"}
        }
      }
    },
    "run_replay": {"$ref": "../../datasets/schema/run-replay-provenance.v1.schema.json"},
    "report_sha256": {"$ref": "../../datasets/schema/run-replay-provenance.v1.schema.json#/$defs/sha256"},
    "error": {"type": "string"},
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_type", "message", "stage"],
      "properties": {
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "stage": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "complete"}}, "required": ["state"]},
      "then": {"required": ["completed_utc", "report_sha256"]}
    },
    {
      "if": {"properties": {"state": {"const": "failed"}}, "required": ["state"]},
      "then": {"required": ["failed_utc", "failure", "error"]}
    }
  ]
}
