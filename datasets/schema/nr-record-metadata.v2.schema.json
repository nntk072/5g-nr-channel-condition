{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:nr-record-metadata:v2",
  "title": "UMCD NR record metadata v2",
  "description": "Metadata stored beside pickle-free NR arrays; target reason arrays use indexes into the exact declared codebook.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sample_id", "receiver_config", "fft_bin_indices",
    "estimate_metadata", "targets", "target_masks", "target_reason_codes",
    "target_reason_codebook", "provenance", "target_definitions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "sample_id": {"type": "string", "minLength": 1},
    "receiver_config": {"type": "object"},
    "fft_bin_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "estimate_metadata": {"type": "object"},
    "targets": {"$ref": "#/$defs/arrayKeyMap"},
    "target_masks": {"$ref": "#/$defs/arrayKeyMap"},
    "target_reason_codes": {"$ref": "#/$defs/arrayKeyMap"},
    "target_reason_codebook": {
      "const": [
        "valid", "not_applicable", "not_observable", "reference_missing",
        "low_confidence_ground_truth", "solver_failure", "censored",
        "outside_calibrated_domain", "sensor_dropout", "saturated",
        "timestamp_gap", "license_restricted", "legacy_reason_unrecorded"
      ]
    },
    "provenance": {"type": "object"},
    "target_definitions": {"type": "object"}
  },
  "$defs": {
    "arrayKeyMap": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}
    }
  }
}
