{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umcd.example/schema/ordered-impairments-snr-acceptance.v3.schema.json",
  "title": "Execution-bound timestamped ordered-impairment SNR-family acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snr_db",
    "channel_seeds",
    "channel_estimator",
    "blocks_per_channel",
    "minimum_independent_channels",
    "maximum_corrected_macro_bler",
    "minimum_uncorrected_minus_corrected_macro_bler",
    "preregistered_utc",
    "execution_context",
    "execution_context_sha256"
  ],
  "properties": {
    "schema": {
      "const": "umcd.ordered_impairments_snr_acceptance.v3"
    },
    "preregistered_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Declared UTC time, covered by the detached signature; timestamp authority is not established by verification."
    },
    "snr_db": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "channel_seeds": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "channel_estimator": {
      "enum": [
        "sionna_default_ls",
        "finite_delay_dft"
      ]
    },
    "blocks_per_channel": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_independent_channels": {
      "type": "integer",
      "minimum": 20
    },
    "maximum_corrected_macro_bler": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "minimum_uncorrected_minus_corrected_macro_bler": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_configuration",
        "decoder_configuration",
        "waveform_configuration"
      ],
      "properties": {
        "receiver_configuration": {
          "type": "object"
        },
        "decoder_configuration": {
          "type": "object"
        },
        "waveform_configuration": {
          "type": "object"
        }
      }
    },
    "execution_context_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
