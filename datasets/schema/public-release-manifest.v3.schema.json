{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/public-release-manifest.v3.schema.json",
  "title": "UMCD public release manifest v3",
  "description": "Strict release inventory with complete ODbL source provenance, hash-bound conversion recipe and third-party license review, and per-artifact lineage declarations. Cross-field checks are enforced by datasets.public_release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_id", "source_software_revision", "artifacts", "scenes"],
  "properties": {
    "schema": {"const": "umcd.public_release.v3"},
    "release_id": {"type": "string", "minLength": 1},
    "source_software_revision": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "items": {"$ref": "#/$defs/scene"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id", "asset_tree_sha256", "license_url", "copyright_notice_url",
        "required_credit", "source_software_revision", "attribution_location",
        "source_data_offer_url", "osm_extract_timestamp", "osm_source_object_ids",
        "conversion_recipe_artifact_path", "conversion_recipe_sha256",
        "third_party_license_closure"
      ],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "asset_tree_sha256": {"$ref": "#/$defs/sha256"},
        "license_url": {"const": "https://opendatacommons.org/licenses/odbl/1-0/"},
        "copyright_notice_url": {"const": "https://www.openstreetmap.org/copyright"},
        "required_credit": {"const": "© OpenStreetMap contributors"},
        "source_software_revision": {"type": "string", "minLength": 1},
        "attribution_location": {"const": "LICENSES/README.txt"},
        "source_data_offer_url": {"type": "string", "format": "uri"},
        "osm_extract_timestamp": {"type": "string", "format": "date-time"},
        "osm_source_object_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(node|way|relation)/[1-9][0-9]*$"}
        },
        "conversion_recipe_artifact_path": {"type": "string", "minLength": 1},
        "conversion_recipe_sha256": {"$ref": "#/$defs/sha256"},
        "third_party_license_closure": {
          "type": "object", "additionalProperties": false,
          "required": ["review_evidence_sha256", "assets"],
          "properties": {
            "review_evidence_sha256": {"$ref": "#/$defs/sha256"},
            "assets": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["asset_path", "asset_sha256", "rights_holder", "license_id", "license_url", "source_url"],
                "properties": {
                  "asset_path": {"type": "string", "minLength": 1},
                  "asset_sha256": {"$ref": "#/$defs/sha256"},
                  "rights_holder": {"type": "string", "minLength": 1},
                  "license_id": {"type": "string", "minLength": 1},
                  "license_url": {"type": "string", "format": "uri"},
                  "source_url": {"type": "string", "format": "uri"}
                }
              }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "license", "license_url", "scene_ids",
        "scene_classifications", "source_scene_tree_sha256", "redistribution",
        "lineage_complete"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "format": "uri"},
        "scene_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scene_classifications": {
          "type": "object",
          "additionalProperties": {"enum": ["odbl_database", "odbl_produced_work"]}
        },
        "source_scene_tree_sha256": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "redistribution": {"const": "permitted"},
        "lineage_complete": {"const": true}
      }
    }
  }
}
