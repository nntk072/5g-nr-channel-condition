{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:near-duplicate-dispositions:v2",
  "title": "Signed UMCD near-duplicate dispositions v2",
  "type": "object",
  "required": [
    "schema",
    "inventory_sha256",
    "candidate_set_sha256",
    "reviewer_id",
    "dispositions"
  ],
  "properties": {
    "schema": {
      "const": "umcd.near_duplicate_dispositions.v2"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidate_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "outcome",
          "rationale",
          "evidence_files"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/sha256"
          },
          "outcome": {
            "enum": [
              "legitimate_similarity",
              "confirmed_leakage"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
