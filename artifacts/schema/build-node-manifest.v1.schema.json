{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:build-node-manifest:v1",
  "title": "Immutable research build node manifest",
  "type": "object",
  "required": ["schema", "node_key", "identity", "artifacts"],
  "properties": {
    "schema": { "const": "loslab.build_node_manifest.v1" },
    "node_key": { "$ref": "#/$defs/sha256" },
    "identity": {
      "type": "object",
      "required": [
        "schema",
        "node_id",
        "node_version",
        "configuration",
        "configuration_schema_sha256",
        "source_revision",
        "source_bundle_sha256",
        "input_files",
        "dependencies",
        "outputs"
      ],
      "properties": {
        "schema": { "const": "loslab.build_node_manifest.v1" },
        "node_id": { "type": "string", "minLength": 1 },
        "node_version": { "type": "string", "minLength": 1 },
        "configuration": { "type": "object" },
        "configuration_schema_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "type": "string", "minLength": 1 },
        "source_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "input_files": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
