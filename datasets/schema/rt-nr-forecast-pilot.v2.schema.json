{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:rt-nr-forecast-pilot:v2",
  "title": "RT NR receiver-only forecast pilot report v2",
  "type": "object",
  "required": [
    "schema",
    "report_schema_sha256",
    "runner_source_sha256",
    "generated_at_utc",
    "command",
    "status",
    "target",
    "model_inputs",
    "methods",
    "split_lock",
    "split_lock_sha256",
    "split_provenance",
    "split_seed",
    "trajectory_count",
    "transition_count",
    "trajectories",
    "forecast_designs",
    "specs",
    "metrics_by_split",
    "predictions",
    "runtime_versions",
    "package_source_sha256",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "loslab.rt_nr_forecast_pilot.v2" },
    "report_schema_sha256": { "$ref": "#/$defs/sha256" },
    "runner_source_sha256": { "$ref": "#/$defs/sha256" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "command": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "status": { "const": "PILOT_FIXED_BASELINES_NOT_A_FORECASTING_CLAIM" },
    "target": { "type": "string", "minLength": 1 },
    "model_inputs": { "type": "string", "minLength": 1 },
    "methods": {
      "type": "object",
      "required": ["persistence", "linear_complex_extrapolation"],
      "properties": {
        "persistence": { "type": "string", "minLength": 1 },
        "linear_complex_extrapolation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "split_lock": { "type": "string", "minLength": 1 },
    "split_lock_sha256": { "$ref": "#/$defs/sha256" },
    "split_provenance": { "type": "object", "minProperties": 1 },
    "split_seed": { "type": ["string", "integer"] },
    "trajectory_count": { "type": "integer", "minimum": 1 },
    "transition_count": { "type": "integer", "minimum": 0 },
    "trajectories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trajectory_id", "scene", "split", "content_sha256", "sample_count"],
        "properties": {
          "trajectory_id": { "type": "string", "minLength": 1 },
          "scene": { "type": "string", "minLength": 1 },
          "split": { "enum": ["train", "validation", "calibration", "test"] },
          "content_sha256": { "$ref": "#/$defs/sha256" },
          "sample_count": { "type": "integer", "minimum": 2 }
        },
        "additionalProperties": false
      }
    },
    "forecast_designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trajectory_id", "horizons_s", "maximum_inter_sample_gap_s", "timestamp_tolerance_s", "mode"],
        "properties": {
          "trajectory_id": { "type": "string", "minLength": 1 },
          "horizons_s": {
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 1, "items": { "type": "number", "exclusiveMinimum": 0 } }
            ]
          },
          "maximum_inter_sample_gap_s": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "timestamp_tolerance_s": { "type": "number", "minimum": 0 },
          "mode": { "enum": ["adjacent_sample_diagnostic", "explicit_elapsed_time_horizons"] }
        },
        "additionalProperties": false
      }
    },
    "specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "metrics_by_split": { "type": "object" },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trajectory_id", "sample_id", "split", "forecast_origin_sample_id", "forecast_origin_s", "forecast_target_s", "horizon_s", "valid_target_element_count", "method", "nmse_linear", "nmse_db"],
        "properties": {
          "trajectory_id": { "type": "string", "minLength": 1 },
          "sample_id": { "type": "string", "minLength": 1 },
          "split": { "enum": ["train", "validation", "calibration", "test"] },
          "forecast_origin_sample_id": { "type": "string", "minLength": 1 },
          "forecast_origin_s": { "type": "number" },
          "forecast_target_s": { "type": "number" },
          "horizon_s": { "type": "number", "exclusiveMinimum": 0 },
          "valid_target_element_count": { "type": "integer", "minimum": 1 },
          "method": { "enum": ["persistence", "linear_complex_extrapolation"] },
          "nmse_linear": { "type": "number", "minimum": 0 },
          "nmse_db": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "runtime_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "package_source_sha256": { "$ref": "#/$defs/sha256" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
