{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:historical-status-crosswalk:v1",
  "title": "Source-bound historical status-note crosswalk inventory",
  "type": "object",
  "required": [
    "schema",
    "authority_note",
    "sources",
    "source_ledger_sha256",
    "manual_mappings_sha256",
    "entry_count",
    "resolved_match_count",
    "resolved_manual_review_count",
    "needs_manual_mapping_count",
    "entries"
  ],
  "properties": {
    "schema": { "const": "loslab.historical_status_crosswalk.v1" },
    "authority_note": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "source_ledger_sha256": { "$ref": "#/$defs/sha256" },
    "manual_mappings_sha256": { "$ref": "#/$defs/sha256" },
    "entry_count": { "type": "integer", "minimum": 0 },
    "resolved_match_count": { "type": "integer", "minimum": 0 },
    "resolved_manual_review_count": { "type": "integer", "minimum": 0 },
    "needs_manual_mapping_count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_key",
          "source_path",
          "line",
          "date",
          "heading",
          "heading_sha256",
          "direct_requirement_aliases",
          "numbered_dataset_criteria",
          "requirement_ids",
          "cited_existing_paths",
          "mapping_state",
          "current_status_authority"
        ],
        "properties": {
          "entry_key": { "$ref": "#/$defs/sha256" },
          "source_path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "format": "date" },
          "heading": { "type": "string", "minLength": 1 },
          "heading_sha256": { "$ref": "#/$defs/sha256" },
          "direct_requirement_aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "numbered_dataset_criteria": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^G[0-9]+\\.[0-9]{2}$" }
          },
          "requirement_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "manual_mapping": {
            "type": "object",
            "required": ["heading_sha256", "block_sha256", "requirement_ids", "rationale"],
            "properties": {
              "heading_sha256": { "$ref": "#/$defs/sha256" },
              "block_sha256": { "$ref": "#/$defs/sha256" },
              "requirement_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "rationale": { "type": "string", "minLength": 20 }
            },
            "additionalProperties": false
          },
          "cited_existing_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "mapping_state": {
            "enum": ["resolved_exact_match", "resolved_manual_review", "needs_manual_mapping"]
          },
          "current_status_authority": { "const": "docs/research/REQUIREMENT_LEDGER.json" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
