{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/pilot-audit.v1.schema.json",
  "title": "UMCD pilot audit v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "implementation_source_sha256", "cli_source_sha256", "status", "qualification_status", "sample_report_sha256", "outcomes_sha256", "selected_candidate_count", "observed_candidate_count", "not_run_candidate_count", "outcome_counts", "runtime_seconds_total", "storage_bytes_total", "cells", "limitations"],
  "properties": {
    "schema": {"const": "umcd.pilot_audit.v1"},
    "implementation_source_sha256": {"$ref": "#/$defs/sha256"},
    "cli_source_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["COMPLETE_DIAGNOSTIC", "INCOMPLETE_DIAGNOSTIC"]},
    "qualification_status": {"const": "NOT_QUALIFIED"},
    "sample_report_sha256": {"$ref": "#/$defs/sha256"},
    "outcomes_sha256": {"$ref": "#/$defs/sha256"},
    "selected_candidate_count": {"type": "integer", "minimum": 0},
    "observed_candidate_count": {"type": "integer", "minimum": 0},
    "not_run_candidate_count": {"type": "integer", "minimum": 0},
    "outcome_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "runtime_seconds_total": {"type": "number", "minimum": 0},
    "storage_bytes_total": {"type": "integer", "minimum": 0},
    "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "p50", "p90", "p99"],
      "properties": {
        "total": {"type": "number", "minimum": 0},
        "p50": {"type": ["number", "null"], "minimum": 0},
        "p90": {"type": ["number", "null"], "minimum": 0},
        "p99": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_family", "antenna_topology", "difficulty", "prior_kind", "cell_id", "requested_independent_groups", "selected_independent_groups", "target_population_probability", "sample_share_within_prior", "design_importance_weight", "observed_candidate_count", "not_run_count", "outcome_counts", "runtime_seconds", "storage_bytes"],
      "properties": {
        "channel_family": {"type": "string", "minLength": 1},
        "antenna_topology": {"type": "string", "minLength": 1},
        "difficulty": {"enum": ["low", "medium", "high"]},
        "prior_kind": {"enum": ["natural_prevalence", "enriched_stress"]},
        "cell_id": {"$ref": "#/$defs/sha256"},
        "requested_independent_groups": {"type": "integer", "minimum": 1},
        "selected_independent_groups": {"type": "integer", "minimum": 0},
        "target_population_probability": {"oneOf": [{"type": "number", "exclusiveMinimum": 0, "maximum": 1}, {"type": "null"}]},
        "sample_share_within_prior": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "design_importance_weight": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "observed_candidate_count": {"type": "integer", "minimum": 0},
        "not_run_count": {"type": "integer", "minimum": 0},
        "outcome_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "runtime_seconds": {"$ref": "#/$defs/distribution"},
        "storage_bytes": {"$ref": "#/$defs/distribution"}
      }
    }
  }
}
