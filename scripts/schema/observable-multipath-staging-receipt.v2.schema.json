{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nntk072/5g-nr-channel-condition/scripts/schema/observable-multipath-staging-receipt.v2.schema.json",
  "title": "Observable multipath preparation and staging receipt v2",
  "type": "object",
  "required": [
    "schema", "state", "phase", "created_utc", "output_directory_name",
    "run_config", "run_config_sha256", "qualification_status", "source_identity",
    "runtime_identity", "command_argv", "rng_streams"
  ],
  "properties": {
    "schema": { "const": "loslab.observable_multipath_staging.v2" },
    "state": { "enum": ["running", "failed"] },
    "phase": { "enum": ["dataset_generation", "model_fitting"] },
    "created_utc": { "type": "string", "format": "date-time" },
    "output_directory_name": { "type": "string", "minLength": 1 },
    "run_config": { "type": "object" },
    "run_config_sha256": { "$ref": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/run-replay-provenance.v1.schema.json#/$defs/sha256" },
    "qualification_status": { "const": "NOT_QUALIFIED" },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "package_source_sha256"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "package_source_sha256": { "$ref": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/run-replay-provenance.v1.schema.json#/$defs/sha256" }
      }
    },
    "runtime_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "dependencies", "requested_device"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "requested_device": { "type": "string", "minLength": 1 }
      }
    },
    "command_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rng_streams": { "$ref": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/run-replay-provenance.v1.schema.json#/properties/rng_streams" },
    "run_replay": { "$ref": "https://github.com/nntk072/5g-nr-channel-condition/datasets/schema/run-replay-provenance.v1.schema.json" },
    "failed_utc": { "type": "string", "format": "date-time" },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["error_type", "message", "stage"],
      "properties": {
        "error_type": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "stage": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "model_fitting" } }, "required": ["phase"] },
      "then": { "required": ["run_replay"] }
    },
    {
      "if": { "properties": { "state": { "const": "failed" } }, "required": ["state"] },
      "then": { "required": ["failed_utc", "failure"] }
    }
  ],
  "additionalProperties": false
}
