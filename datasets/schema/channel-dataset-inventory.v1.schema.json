{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:channel-dataset-inventory:v1",
  "title": "Frozen ChannelDataset corpus inventory",
  "description": "Exact file set and byte/row identities for a saved ChannelDataset corpus audit. Freezing is declarative; external signature and trust verification remain separate requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frozen", "inventory_id", "datasets"],
  "properties": {
    "schema": {"const": "umcd.channel_dataset_inventory.v1"},
    "frozen": {"const": true},
    "inventory_id": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256", "bytes", "rows"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}($|/))[^\\\\]+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "rows": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
