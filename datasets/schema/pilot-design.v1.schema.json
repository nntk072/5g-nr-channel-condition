{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loslab.invalid/schema/pilot-design.v1.schema.json",
  "title": "UMCD pilot design v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sampling_seed", "prior_provenance_sha256", "mandatory_channel_families", "mandatory_antenna_topologies", "mandatory_difficulties", "required_prior_kinds", "cells"],
  "properties": {
    "schema": {"const": "umcd.pilot_design.v1"},
    "sampling_seed": {"type": "integer", "minimum": 0, "maximum": 340282366920938463463374607431768211455},
    "prior_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "mandatory_channel_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mandatory_antenna_topologies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mandatory_difficulties": {"type": "array", "minItems": 2, "uniqueItems": true, "contains": {"const": "low"}, "allOf": [{"contains": {"const": "high"}}], "items": {"enum": ["low", "medium", "high"]}},
    "required_prior_kinds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["natural_prevalence", "enriched_stress"]}},
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_family", "antenna_topology", "difficulty", "prior_kind", "independent_groups", "target_population_probability"],
      "properties": {
        "channel_family": {"type": "string", "minLength": 1},
        "antenna_topology": {"type": "string", "minLength": 1},
        "difficulty": {"enum": ["low", "medium", "high"]},
        "prior_kind": {"enum": ["natural_prevalence", "enriched_stress"]},
        "independent_groups": {"type": "integer", "minimum": 1},
        "target_population_probability": {"oneOf": [{"type": "number", "exclusiveMinimum": 0, "maximum": 1}, {"type": "null"}]}
      }
    }
  }
}
