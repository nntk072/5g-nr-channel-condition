{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:loslab:g4-fixed-tdl-tap-profile-reference:v1",
  "title": "G4 Fixed TDL Per-Component Tap References",
  "description": "Source-hash-bound ETSI Annex B tap rows, preserving separate LOS and diffuse components at a shared delay. This reference is not a conformance verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "standard", "version", "source_id", "source_sha256", "source_url", "reference_scope", "status", "profiles", "interpretation"],
  "properties": {
    "schema": { "const": "loslab.g4_fixed_tdl_tap_profile_reference.v1" },
    "standard": { "const": "3GPP TS 38.101-4" },
    "version": { "const": "19.2.2" },
    "source_id": { "const": "ts-138101-4-v19.2.2" },
    "source_sha256": { "const": "b3c6a73c7a40219e7270c08c7a57c84cb46f6757b303a64ec768ba04a6079e81" },
    "source_url": { "const": "https://www.etsi.org/deliver/etsi_ts/138100_138199/13810104/19.02.02_60/ts_13810104v190202p.pdf" },
    "reference_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "PER_TAP_REFERENCE_ONLY_NOT_CONFORMANCE_QUALIFICATION" },
    "profiles": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["profile_model", "source_tables", "tap_count", "minimum_channel_bandwidth_hz_exclusive", "components"],
        "properties": {
          "profile_model": { "enum": ["A10", "A30", "B100", "C60", "C300", "D10", "D30"] },
          "source_tables": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^B\\.2\\.1\\.[12]-[1-6]$" } },
          "tap_count": { "type": "integer", "minimum": 1 },
          "minimum_channel_bandwidth_hz_exclusive": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "components": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["component_index", "tap_index", "delay_ns", "power_db", "fading_distribution"],
              "properties": {
                "component_index": { "type": "integer", "minimum": 1 },
                "tap_index": { "type": "integer", "minimum": 1 },
                "delay_ns": { "type": "number", "minimum": 0 },
                "power_db": { "type": "number" },
                "fading_distribution": { "enum": ["Rayleigh", "LOS path", "LOS"] }
              }
            }
          }
        }
      }
    },
    "interpretation": { "type": "string", "minLength": 1 }
  }
}
