{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:umcd:corpus-audit-report:v6",
  "title": "UMCD corpus audit report v6",
  "description": "Hash-bound corpus integrity report. Near-duplicate screening distinguishes complete candidate scans from comparisons skipped because their CFR has zero norm.",
  "type": "object",
  "required": ["schema", "qualification", "report_sha256"],
  "properties": {
    "schema": {"const": "umcd.corpus_audit_report.v6"},
    "qualification": {"const": "not_claimed"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "required": [
        "inventory_id",
        "inventory_sha256",
        "bundle_manifest_sha256",
        "split_registry_file_sha256",
        "checks",
        "external_gates",
        "fixture_notice",
        "report_sha256"
      ],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_manifest_sha256": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "split_registry_file_sha256": {"$ref": "#/$defs/sha256"},
        "checks": {
          "type": "object",
          "required": ["near_duplicate_review"],
          "properties": {
            "near_duplicate_review": {"$ref": "#/$defs/nearDuplicateReview"}
          }
        },
        "external_gates": {"type": "object"},
        "fixture_notice": {"type": "string", "minLength": 1}
      }
    },
    {
      "required": ["inventory_sha256", "execution", "report_sha256"],
      "properties": {
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "execution": {
          "type": "object",
          "required": ["status", "error"],
          "properties": {
            "status": {"const": "failed"},
            "error": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nearDuplicateReview": {
      "type": "object",
      "required": [
        "status",
        "threshold",
        "comparable_group_count",
        "cross_split_pair_count",
        "total_pair_comparison_count",
        "candidate_count",
        "candidates",
        "skipped_comparison_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "review_required",
            "incomplete_comparisons",
            "no_candidates_detected",
            "not_run_no_cross_split_pairs"
          ]
        },
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "comparable_group_count": {"type": "integer", "minimum": 0},
        "cross_split_pair_count": {"type": "integer", "minimum": 0},
        "total_pair_comparison_count": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sample_id_a",
              "sample_id_b",
              "split_id_a",
              "split_id_b",
              "geometry_hash_match",
              "normalized_complex_inner_product_magnitude"
            ],
            "properties": {
              "sample_id_a": {"type": "string", "minLength": 1},
              "sample_id_b": {"type": "string", "minLength": 1},
              "split_id_a": {"type": "string", "minLength": 1},
              "split_id_b": {"type": "string", "minLength": 1},
              "geometry_hash_match": {"type": "boolean"},
              "normalized_complex_inner_product_magnitude": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "skipped_comparison_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
