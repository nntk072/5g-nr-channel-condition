{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:5gnr:historical-status-manual-mappings:v1",
  "title": "Reviewed manual mapping for a dated research status note",
  "type": "object",
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "loslab.historical_status_manual_mappings.v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/mapping" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mapping": {
      "type": "object",
      "required": ["entry_key", "heading_sha256", "block_sha256", "requirement_ids", "rationale"],
      "properties": {
        "entry_key": { "$ref": "#/$defs/sha256" },
        "heading_sha256": { "$ref": "#/$defs/sha256" },
        "block_sha256": { "$ref": "#/$defs/sha256" },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    }
  }
}
