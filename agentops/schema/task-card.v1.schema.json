{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nr-agentops.task-card.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "title", "kind", "source_revision", "status", "priority", "requirement_ids", "dependencies", "owned_paths", "readonly_paths", "resource_class", "verification_gates", "scientific_disposition", "owner_id", "reviewer_id", "permissions", "max_fix_attempts"],
  "properties": {
    "schema": {"const": "nr-agentops.task-card.v1"},
    "task_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "kind": {"enum": ["validation", "implementation", "qa", "docs", "audit", "native_experiment"]},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["ready", "blocked", "done"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100000},
    "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"}},
    "owned_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "readonly_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_class": {"enum": ["docs_only", "cpu_test", "native_smoke", "scientific_native", "production_d1"]},
    "verification_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["agent", "fast", "core", "build", "full", "native-smoke", "scoped"]}},
    "scoped_verification": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "scientific_disposition": {"enum": ["NOT_APPLICABLE", "NOT_QUALIFIED"]},
    "owner_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["source_write", "commit", "push", "native_gpu", "scientific_qualification"],
      "properties": {
        "source_write": {"type": "boolean"}, "commit": {"const": false}, "push": {"const": false},
        "native_gpu": {"type": "boolean"}, "scientific_qualification": {"const": false}
      }
    },
    "max_fix_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
    "block_reason": {"type": "string", "minLength": 1}
  }
}
